# SERVER-ONLY переменные (никогда не использовать префикс NEXT_PUBLIC_ для секретов).
# Скопируйте в .env.local при подключении реального провайдера.

# ОБЯЗАТЕЛЬНО. Без AI_PROVIDER маршрут /api/ai/analyze отвечает
# 503 ai_not_configured — молчаливого fallback на mock больше нет.
# Development only: mock-провайдер включается ТОЛЬКО явным AI_PROVIDER=mock.
# Production: AI_PROVIDER=openai-compatible плюс AI_API_KEY и AI_MODEL.
AI_PROVIDER=mock

# Модель провайдера, например gpt-4o-mini.
# Обязательна при AI_PROVIDER=openai-compatible.
AI_MODEL=

# Секретный ключ. Обязателен при AI_PROVIDER=openai-compatible.
# При AI_PROVIDER=mock не используется.
AI_API_KEY=

# Опционально: base URL OpenAI-compatible API
# AI_BASE_URL=https://api.openai.com/v1

# ---------- P18: HH URL import (server-side fetch hh.ru) ----------

# Опционально: max response size в BYTES для /api/vacancies/import
# (default: 2097152 = 2MB; публичная HH vacancy ~834KB).
# HH_IMPORT_MAX_BYTES=2097152
